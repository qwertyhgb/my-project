# --------------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
build/
dist/

# --------------------------------------------------------------------------- IDE and OS
.idea/
.vscode/
.DS_Store
*.swp
*~

# --------------------------------------------------------------------------- 私有与派生数据（原始医学数据保持只读且不入库）
# 注意：data/splits/ 与 data/metadata/ 下的**小体积 JSON/CSV 清单**是历史事实的一部分，
# 已被 git 跟踪；这里只忽略体积大、可由脚本重建的派生数据。
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# --------------------------------------------------------------------------- 运行期产物
logs/**
workdir/**
outputs/checkpoints/**
outputs/predictions/**
outputs/diagnostics/**
!logs/.gitkeep
!workdir/.gitkeep
!outputs/checkpoints/.gitkeep
!outputs/predictions/.gitkeep
!outputs/diagnostics/.gitkeep

# --------------------------------------------------------------------------- 数据集级运行产物（大文件，不入库；由实验日志与哈希追溯）
outputs/nnUNet_results/**
outputs/metrics/**
outputs/reports/**
outputs/figures/**
outputs/ablations/**
outputs/external/**
!outputs/**/.gitkeep

# --------------------------------------------------------------------------- 第三方差分：只记录 provenance，不 vendored
third_party/*
!third_party/README.md

# --------------------------------------------------------------------------- 本地环境文件
.env
.env.*
*.log

# --------------------------------------------------------------------------- 二进制/大数据文件兜底（任何目录）
*.pth
*.pt
*.npz
*.npy
*.pkl
*.h5
*.nii
*.nii.gz
*.b2nd
*.bin
*.onnx

# --------------------------------------------------------------------------- 新主线的中间产物（由数据脚本生成，可重建，不入库）
workdir/anatomy_priors/
workdir/anatomy_rois/
workdir/hard_negatives/
outputs/run_configs/
